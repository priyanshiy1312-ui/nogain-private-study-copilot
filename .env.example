# NOGAIN_LLM=mock runs with zero setup (canned model). Use "live" for Nebius Token Factory.
NOGAIN_LLM=mock
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Verify exact IDs with GET /v1/models (docs show slightly different spellings)
NOGAIN_MODEL=nvidia/nemotron-3-super-120b-a12b
NOGAIN_FAST_MODEL=nvidia/nvidia-nemotron-3-nano-30b-a3b
# Morning briefing interval in seconds (use 30 for the demo)
NOGAIN_BRIEFING_SECONDS=30
